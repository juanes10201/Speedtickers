; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PlatformerGame"
run/main_scene="res://assets/Levels/world1/initial_credits.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

InitialGameLoad="*res://assets/Levels/Scripts/initial_game_load.gd"
GlobalSignal="*res://assets/global_signal/global_signal.gd"
SaveGame="*res://assets/Levels/Scripts/save_game.gd"
SongPlayer="*res://assets/Levels/SongPlayer.tscn.tscn"
Edition="*res://assets/Levels/Scripts/game_editions.gd"
LevelManager="*res://assets/Levels/world1/LevelManager.tscn"
Global="*res://assets/Levels/Scripts/global_variables.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[debug]

file_logging/enable_file_logging=true

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"lobby_initial": "res://assets/Timeline/lobby_initial.dtl"
}
layout/style_directory={}

[display]

window/stretch/mode="viewport"
window/quality/use_taa=false

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

Tileset=""
Player=""
GameTimer=""
PlayerEnemiesCollision=""
PlayerHitBox=""
sand=""
Enemie=""
Piston=""

