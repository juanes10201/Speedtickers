code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D screen_tex_frg_2 : hint_screen_texture;


// TurnGameBoyPalette
#include \"res://addons/shaderV/rgba/turnGBPalette.gdshaderinc\"

void fragment() {
	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(screen_tex_frg_2, SCREEN_UV);


	vec3 n_out3p0;
// TurnGameBoyPalette:3
	float n_in3p1 = 0.81000;
	{
		n_out3p0 = _gameboyPaletteFunc(vec3(n_out2p0.xyz), n_in3p1);
	}


// Output:0
	COLOR.rgb = n_out3p0;


}
"
